# Nested loops: print the primes below 50
let n = 2
let found = 0
while n < 50 {
    let d = 2
    let prime = true
    while d * d <= n and prime {
        if n % d == 0 {
            prime = false
        }
        d = d + 1
    }
    if prime {
        print(n)
        found = found + 1
    }
    n = n + 1
}
print("primes found:", found)
